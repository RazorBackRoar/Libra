{
  "name": "l-bra",
  "version": "1.0.0",
  "productName": "L!bra",
  "main": "build/main/index.js",
  "description": "Organize and enhance videos locally",
  "iconDescription": "L!bra is a local-first macOS video organization and metadata toolkit with 12 specialized tools for renaming, sorting, analyzing, and enhancing video files. Users drag videos and folders from Finder directly into the app to scan metadata, detect duplicates, sort by resolution and codec, adjust timestamps, and apply batch operations—all without uploading to the cloud. Think of a film reel or library catalog system, a video scanner with metadata cards, or a filing system with gold accents organizing black folders. Aesthetic: modern macOS-native, sleek black and gold, professional video toolkit.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:preload": "esbuild renderer/preload.ts --bundle --platform=node --target=es2022 --format=cjs --tsconfig=tsconfig.json --outfile=build/assets/preload.cjs --external:electron",
    "build:main": "esbuild main/index.ts --bundle --platform=node --target=node22 --format=esm --tsconfig=tsconfig.json --outdir=build/main --external:electron '--external:node:*'",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "npm run build:preload && npm run build:main && npm run build:renderer",
    "dev:preload": "npm run build:preload",
    "dev:main": "npm run build:main && electron build/main/index.js",
    "dev:renderer": "vite dev --config vite.renderer.config.ts",
    "dev": "concurrently --kill-others --names RENDERER,MAIN \"npm run dev:renderer\" \"npm run dev:main\"",
    "start": "unset ELECTRON_RUN_AS_NODE && electron build/main/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "oxfmt --write .",
    "dist": "npm run build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.razorbackroar.libra",
    "productName": "L!bra",
    "executableName": "Libra",
    "files": [
      "build/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "app-icon.icns",
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "extraResources": [
        {
          "from": "app-icon.png",
          "to": "icon.png"
        }
      ]
    },
    "dmg": {
      "icon": "app-icon.icns",
      "sign": false
    }
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-router": "^1.131.36",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.542.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@rolldown/plugin-babel": "^0.2.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.6",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17.3.0",
    "oxfmt": "^0.26.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.5.3",
    "vite": "^8.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.11.0+sha512-82gRxKrh/eY5UnNorkTFcdBQAGpgjWehkfGVqAGlJjejEtJZGGJUqjo3mbBTNbc5BTnPKGVtGPBZGhElujX5cw==",
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
